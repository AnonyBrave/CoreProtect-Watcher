# Fichier d'exemple — copier en `.env` puis remplir (ne jamais commité, il porte les secrets).
# Connexion MySQL CoreProtect — LECTURE SEULE uniquement.
CP_DB_HOST=192.168.1.30
CP_DB_PORT=3306
CP_DB_USER=coreprotectui
CP_DB_PASSWORD=<mot-de-passe-lecture-seule>
CP_DB_NAME=coreprotect

# Serveur de l'UI (ancien nom CP_SENTRY_PORT lu en fallback)
CP_WATCHER_PORT=8765
CP_ADMIN_TOKEN=<jeton-admin-a-changer>

# Cycle d'ingestion (secondes) et recomputation lourde (minutes)
CP_INGEST_SECONDS=120
CP_RECOMPUTE_MINUTES=60

# Source des données : mysql = 100 % MySQL live, files = dumps SQL, auto = MySQL si joignable sinon fichiers.
CP_SOURCE=auto
# Dossier surveillé pour les dumps mysqldump (.sql ou .sql.gz), copié dedans par l'exploitant.
CP_IMPORT_DIR=data/imports

# Webhook Discord (vide = désactivé)
DISCORD_WEBHOOK_URL=

# Emplacement du cache SQLite (optionnel ; vide = ./data/coreprotect-watcher.db)
CP_SQLITE_FILE=
